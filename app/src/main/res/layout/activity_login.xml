<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login">

    <!-- 光晕：右上靛蓝，左下紫罗兰 -->
    <View
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-140dp"
        android:layout_marginEnd="-110dp"
        android:background="@drawable/glow_primary" />

    <View
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-150dp"
        android:layout_marginStart="-90dp"
        android:background="@drawable/glow_violet" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="60dp"
            android:paddingEnd="60dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">

            <!-- 品牌区 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="32dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_brand_logo"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"
                    android:text="fnPhoto"
                    android:textColor="@color/text_primary"
                    android:textSize="44sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="你的私有云相册，大屏也好看"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/dot_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="时间轴、相册、人物与地点"
                        android:textColor="@color/text_tertiary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/dot_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="数据留在你自己的 NAS 上"
                        android:textColor="@color/text_tertiary"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- 登录卡片 -->
            <LinearLayout
                android:layout_width="398dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="26dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="登录"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="20dp"
                    android:text="连接到你的 fnNAS"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    style="@style/FormLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NAS 地址" />

                <EditText
                    android:id="@+id/edit_nas_url"
                    style="@style/InputField"
                    android:layout_marginBottom="12dp"
                    android:hint="IP / 域名 / FN ID"
                    android:imeOptions="actionNext"
                    android:inputType="textUri"
                    android:nextFocusDown="@+id/edit_username">

                </EditText>

                <TextView
                    style="@style/FormLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="账号" />

                <EditText
                    android:id="@+id/edit_username"
                    style="@style/InputField"
                    android:layout_marginBottom="12dp"
                    android:hint="用户名"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:nextFocusDown="@+id/edit_api_token"
                    android:nextFocusUp="@+id/edit_nas_url" />

                <TextView
                    style="@style/FormLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="密码" />

                <EditText
                    android:id="@+id/edit_api_token"
                    style="@style/InputField"
                    android:hint="密码"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:nextFocusDown="@+id/btn_login"
                    android:nextFocusUp="@+id/edit_username" />

                <CheckBox
                    android:id="@+id/cb_remember"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:buttonTint="@color/immich_primary"
                    android:checked="true"
                    android:focusable="true"
                    android:nextFocusDown="@+id/btn_login"
                    android:nextFocusUp="@+id/edit_api_token"
                    android:text="在此设备上记住登录"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_login"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="16dp"
                    android:nextFocusUp="@+id/edit_api_token"
                    android:text="连接并登录" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:id="@+id/progress_bar"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:indeterminateTint="@color/immich_primary"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
